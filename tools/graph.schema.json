{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markus-learning.github.io/ROBOTICS-for-PEOPLE/graph.schema.json",
  "title": "Robotics for People knowledge graph",
  "description": "Every note of the textbook with its metadata, typed edges between notes, the subfield map, and the notes other notes link to that do not exist yet. Generated by tools/sitebuild.py export.",
  "type": "object",
  "required": [
    "version",
    "title",
    "base_url",
    "repository",
    "license",
    "generated",
    "counts",
    "subfields",
    "nodes",
    "edges",
    "missing"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "generated": {
      "type": "string",
      "format": "date"
    },
    "counts": {
      "type": "object",
      "required": [
        "notes",
        "edges",
        "missing",
        "subfields"
      ],
      "properties": {
        "notes": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "subfields": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "subfields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "group",
          "description",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "group": {
            "enum": [
              "core",
              "body",
              "domain",
              "society",
              "frontier"
            ]
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "path",
          "url",
          "raw_url",
          "type",
          "level",
          "subfield",
          "status",
          "tags",
          "prerequisites",
          "related",
          "chapter",
          "word_count",
          "inbound_links",
          "slug"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The note's file name without .md; what [[wikilinks]] use."
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "Path in the repository."
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "raw_url": {
            "type": "string",
            "format": "uri",
            "description": "The note's Markdown source."
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "concept",
              "method",
              "component",
              "robot-type",
              "application",
              "tool",
              "tutorial",
              "lab",
              "overview",
              "reference",
              "guide",
              "person"
            ]
          },
          "level": {
            "enum": [
              "beginner",
              "intermediate",
              "advanced",
              "research"
            ]
          },
          "subfield": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 3
          },
          "status": {
            "enum": [
              "stub",
              "draft",
              "reviewed",
              "keystone"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Ids of notes to read first."
          },
          "related": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "key_takeaways": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_reviewed": {
            "type": [
              "string",
              "null"
            ]
          },
          "chapter": {
            "type": "string"
          },
          "word_count": {
            "type": "integer",
            "minimum": 0
          },
          "inbound_links": {
            "type": "integer",
            "minimum": 0
          },
          "slug": {
            "type": "string",
            "description": "The note's path on the site, relative to the site root."
          },
          "as_of": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$",
            "description": "Month the note's state-of-the-art content was last checked against current sources."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Citations: \"Author or org (Year). Title. URL\"."
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "kind"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "links_to",
              "related",
              "prerequisite"
            ],
            "description": "prerequisite edges point from the note to read first to the note that needs it."
          }
        }
      }
    },
    "missing": {
      "type": "array",
      "description": "Notes that existing notes link to but nobody has written yet, most wanted first.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "references",
          "linked_from"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "references": {
            "type": "integer",
            "minimum": 1
          },
          "linked_from": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "likely_subfield": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
